PORT=3001
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
# seed solo habilita lecturas locales de demostración; producción requiere prisma.
DATA_SOURCE=seed
# Conexión runtime del backend. Copiar la URL real desde Connect en Supabase.
DATABASE_URL=
# Conexión directa o pooler de sesión para migraciones, distinta del pooler transaccional.
DIRECT_URL=
# Integración Storage futura; nunca utilizar VITE_ para claves privadas.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=avisos
